# Required
CERTBOT_EMAIL=your@email.org

# Optional (Defaults)
DHPARAM_SIZE=2048
ELLIPTIC_CURVE=secp256r1
RENEWAL_INTERVAL=8d
RSA_KEY_SIZE=2048
STAGING=0
USE_ECDSA=1

# Advanced (Defaults)
# Set a default DNS provider for all certs without an explicit .dns-<provider> suffix.
# Example: LEGO_DEFAULT_PROVIDER=cloudflare
# CERTBOT_AUTHENTICATOR is accepted as a backward-compatible alias.
LEGO_DEFAULT_PROVIDER=
DEBUG=0
USE_LOCAL_CA=0

# Certificates to obtain and renew that no nginx server block references,
# because something other than this nginx serves them. Entries are separated by
# ';' and the domains within an entry by ','. The value may span several lines,
# but each entry must still end with its ';' — a newline counts as whitespace.
# Example: LEGO_EXTRA_CERTS=edge=example.org,www.example.org;api=*.api.example.org
LEGO_EXTRA_CERTS=

# How many levels of 'include' directives to follow when reading a config file.
NGINX_INCLUDE_MAX_DEPTH=10
